# PostgreSQL connection used by the application and Drizzle migrations.
DATABASE_URL=postgresql://fundsroom_app:replace_with_a_strong_password@localhost:5432/fundsroom_erp
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=1h
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Docker PostgreSQL configuration. Use a strong local-only password.
POSTGRES_DB=fundsroom_erp
POSTGRES_USER=fundsroom_app
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_PORT=5432

# Required only by the seed command. These values are hashed before insertion.
SEED_ADMIN_PASSWORD=replace_with_a_strong_admin_password
SEED_SALES_PASSWORD=replace_with_a_strong_sales_password
